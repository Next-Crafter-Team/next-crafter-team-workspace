# Clerk Publishable Key. Public by design — the Secret Key lives in Convex env vars.
# `npx clerk@latest init` writes a development key here for you.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex deployment URL. `npx convex dev` prints it and writes CONVEX_URL to
# the workspace root .env.local; copy that value here.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
